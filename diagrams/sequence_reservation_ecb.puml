@startuml
actor Student
boundary ":StudentDashboardUI" as UI
control ":ReservationControl" as Ctrl
entity "spot : ParkingSpot" as Spot
entity "res : Reservation" as Res
entity "user : User" as Usr
boundary ":LprGateBoundary" as LPR

Student -> UI : onReserveSpotClicked("EV-04", "12-345-67")
activate UI
UI -> Ctrl : reserveSpot(userId, "EV-04", "12-345-67")
activate Ctrl
Ctrl -> Spot : isAvailable()
activate Spot
Spot --> Ctrl : available
deactivate Spot

alt available == true
    Ctrl -> Spot : tryReserve(expectedVersion)
    activate Spot
    Spot --> Ctrl : acquired
    deactivate Spot
    note right of Spot
      Atomic check-and-set: succeeds only if status == AVAILABLE
      and version == expectedVersion, then sets RESERVED and version + 1
    end note

    alt acquired == true
        create Res
        Ctrl -> Res : <<create>>
        Ctrl --> UI : res
        UI -> UI : displayCountdown(15)
    else Concurrent Race Condition
        Ctrl --> UI : reservation not acquired
        UI -> UI : showErrorAlert("Spot just reserved by another user")
    end
else
    Ctrl --> UI : spot unavailable
    UI -> UI : showErrorAlert("Spot unavailable")
end
deactivate Ctrl
UI --> Student : reservation result
deactivate UI

== Within 15 Minutes: Vehicle Arrives at Entrance Gate ==

LPR -> Ctrl : processLprGateEntry("12-345-67", "EV Zone")
activate Ctrl
Ctrl -> Res : isWithin15MinWindow()
activate Res
Res --> Ctrl : valid
deactivate Res

alt valid == true
    Ctrl -> Res : setStatus(FULFILLED)
    activate Res
    Res --> Ctrl : status updated
    deactivate Res
    Ctrl -> LPR : openBarrierGate()
    activate LPR
    LPR --> Ctrl : gate opened
    deactivate LPR
    Ctrl --> LPR : entry accepted
else No-Show > 15 Min
    Ctrl -> Res : setStatus(NO_SHOW_REVOKED)
    activate Res
    Res --> Ctrl : status updated
    deactivate Res
    Ctrl -> Usr : incrementNoShowWarnings()
    activate Usr
    Usr --> Ctrl : warnings updated
    deactivate Usr
    destroy Res
    Ctrl -> LPR : denyEntry()
    activate LPR
    LPR --> Ctrl : entry denied
    deactivate LPR
    Ctrl --> LPR : entry denied
end
deactivate Ctrl
@enduml